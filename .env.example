# Copy to .env and fill in. Read by agents_common.config.Settings when you run an agent
# directly on the host (`uv run react-agent ...`). docker-compose.yml overrides POSTGRES_HOST
# (and only that) to "postgres" for containerized services, since they reach Postgres over the
# compose network rather than the published localhost port.

# --- Postgres (checkpointing + long-term memory store) ----------------------
# Settings.postgres_uri is built from these five values — change one here rather than also
# updating a separate connection-string field.
POSTGRES_USER=agents
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agents
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MLflow (observability + model access, both via the same server) --------
MLFLOW_TRACKING_URI=http://localhost:5000
# The only credential this repo needs. Models are called through the self-hosted MLflow AI
# Gateway rather than a provider API key (no ANTHROPIC_API_KEY, etc.) — this one bearer token
# authenticates tracking, mlflow.genai.evaluate(), and gateway model calls alike. See
# agents_common.models.get_chat_model.
MLFLOW_TRACKING_TOKEN=
# No MLFLOW_EXPERIMENT_NAME here on purpose: every agent owns its own experiment name as a
# constant in its own package (e.g. react_agent.EXPERIMENT_NAME) rather than sharing one name
# across every pattern in this repo — see agents_common.observability.configure_mlflow.

# --- Gateway route provisioning (one-off; see packages/mlflow-server/scripts) -----
# Only read by provision_gateway_route.py, not by agent code — the credentials the gateway
# itself uses to call the upstream self-hosted model, distinct from MLFLOW_TRACKING_TOKEN
# above (which authenticates *callers of* the gateway, not the gateway's outbound calls).
SELFHOSTED_MODEL_BASE_URL=https://gpt-oss-120b-asktz-request-model.apps.sc-tzai.pok-lb.techzone.ibm.com/v1
SELFHOSTED_MODEL_API_KEY=
SELFHOSTED_MODEL_NAME=gpt-oss-120b
# Route name agent code calls via get_chat_model(...) / react_agent.GATEWAY_ROUTE — defaults
# to SELFHOSTED_MODEL_NAME if unset.
GATEWAY_ROUTE_NAME=gpt-oss-120b

# --- MLflow server's own backend store (see packages/mlflow-server) ---------
# Only read by the mlflow-server container itself, not by agent code — kept separate from the
# POSTGRES_* block above because it always points at the "mlflow" database regardless of which
# database the agents are configured to use.
MLFLOW_BACKEND_STORE_URI=postgresql://agents:change-me@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=/mlartifacts

# --- Milvus (vector store, see packages/milvus) ------------------------------
# The only Milvus value agent code reads — etcd/MinIO are internal to the Milvus service and
# never touched by agents_common. localhost:19530 is the published host port; docker-compose
# overrides this to http://milvus-standalone:19530 for containerized services, same pattern as
# POSTGRES_HOST above. No agent in this repo uses this yet — see packages/milvus/README.md.
MILVUS_URI=http://localhost:19530

# --- Agent runtime ------------------------------------------------------------
LOG_LEVEL=INFO
